{
  "name": "vue-cloud-console",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-18-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "postCreateCommand": "npm ci --no-audit --no-fund && cp -n .env.example .env",
  "postStartCommand": "nohup npm run dev -- --host 0.0.0.0 > /tmp/vite.log 2>&1 &",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Cloud Console (Vite dev server)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer"
      ]
    }
  }
}
