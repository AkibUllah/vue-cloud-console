{
  "name": "vue-cloud-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "2.2.2",
    "vue": "3.5.44",
    "vue-router": "4.4.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-vue": "5.1.4",
    "@vue/eslint-config-typescript": "13.0.0",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.0",
    "eslint-plugin-vue": "9.28.0",
    "jsdom": "24.1.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.13",
    "typescript": "5.4.5",
    "vite": "5.4.8",
    "vitest": "1.6.0",
    "vue-tsc": "2.1.6"
  }
}
